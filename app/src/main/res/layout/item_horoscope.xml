<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="12dp"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:background="@drawable/horoscope_item_background">

    <ImageView
        android:id="@+id/signImageView"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/aries_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/nameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Horoscope name"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/datesTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Horoscope dates"
            android:textSize="16sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/favorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_favorite_selected" />

</LinearLayout>
